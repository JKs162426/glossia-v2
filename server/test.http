# Requests for the VS Code REST Client extension.
# Run "Login" first and paste the token from the Set-Cookie header below.
# Never commit real tokens to this file.
@api = http://localhost:3000/api
@token = paste-token-here

### Register
POST {{api}}/auth/register
Content-Type: application/json

{
  "username": "jesus",
  "email": "jesus@test.com",
  "password": "glossia123"
}

### Login (token is returned in the glossia_token cookie)
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "jesus@test.com",
  "password": "glossia123"
}

### Current user
GET {{api}}/auth/me
Authorization: Bearer {{token}}

### Register - invalid fields
POST {{api}}/auth/register
Content-Type: application/json

{
  "username": "jesus k",
  "email": "notanemail",
  "password": "123"
}

### Update target language
PUT {{api}}/users/language
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "language": "fr"
}

### Get favorites
GET {{api}}/favorites
Authorization: Bearer {{token}}

### Add favorite
POST {{api}}/favorites
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "word": "hola",
  "translation": "hello",
  "language": "es"
}

### Delete favorite
DELETE {{api}}/favorites/1
Authorization: Bearer {{token}}

### Categories (with word count for a language)
GET {{api}}/categories?language=es
Authorization: Bearer {{token}}

### Flashcard deck for category 1 in Spanish
GET {{api}}/categories/1/deck?language=es
Authorization: Bearer {{token}}

### Save a flashcard session
POST {{api}}/flashcards/sessions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "language": "es",
  "categoryId": 1,
  "results": [{ "word": "Hola", "correct": true }]
}

### Learning path
GET {{api}}/learn/path?language=es
Authorization: Bearer {{token}}

### Lesson content
GET {{api}}/learn/lessons/a1-u1-l1?language=es
Authorization: Bearer {{token}}

### Complete a lesson
POST {{api}}/learn/lessons/a1-u1-l1/complete
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "language": "es",
  "correct": 12,
  "total": 13
}

### Dashboard stats
GET {{api}}/stats/overview?language=es
Authorization: Bearer {{token}}
