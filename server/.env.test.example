# Copy to .env.test for `npm test`. Only a database whose name ends in
# "_test" is accepted; it is created and migrated automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=glossia_test

# Any long random string; only used to sign tokens inside the tests.
JWT_SECRET=test-only-secret-not-used-anywhere-else-0123456789
