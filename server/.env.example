PORT=3000
NODE_ENV=development
# Production only: number of proxies in front of the app (see README)
TRUST_PROXY_HOPS=3
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=glossia
# Production (Aiven): the CA certificate, to connect over TLS
DB_SSL_CA=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional — the "Continue with Google" button is disabled without these
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
